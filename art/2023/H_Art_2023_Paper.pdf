   <dc:creator>
    <rdf:Seq>
     <rdf:li>speedshutter Photography</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">A radio is essential to receive emergency information. Any hand-cranked or battery-operated radio can provide important information on weather or evacuation alerts. It can also operate as a flashlight</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">1705516570</rdf:li>
    </rdf:Alt>
   </dc:title>
