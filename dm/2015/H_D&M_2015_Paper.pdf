   xmpMM:InstanceID="xmp.iid:A7392EA8081FE5118157D49EAFD0ADA9"
   xmpMM:DocumentID="xmp.did:A4392EA8081FE5118157D49EAFD0ADA9"
   xmpMM:OriginalDocumentID="xmp.did:A4392EA8081FE5118157D49EAFD0ADA9">
   <dc:title>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Folding Garden Wheelbarrow</rdf:li>
    </rdf:Alt>
   </dc:title>
   <dc:creator>
    <rdf:Seq>
     <rdf:li>Trueshopping</rdf:li>
    </rdf:Seq>
   </dc:creator>
   <dc:description>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Sturdy yet lightweight, this folding wheelbarrow from Trueshopping folds flat for easier storage. A practical addition to any garden, this wheelbarrow features a steel frame and a polyester bag that's easy to wipe clean. This folding wheelbarrow has a maximum capacity of 50kg. &#xA;</rdf:li>
    </rdf:Alt>
   </dc:description>
   <dc:rights>
    <rdf:Alt>
     <rdf:li xml:lang="x-default">Â© Copyright 2015 Trueshopping. All Rights Reserved. Trueshopping Limited, Unit 1 &amp; 2 Dawson Court, Billington Road, Burnley, Lancashire BB11 5UB, England.</rdf:li>
    </rdf:Alt>
   </dc:rights>
